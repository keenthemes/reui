{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"c-trace-13","type":"registry:block","title":"Data pipeline run","description":"A dbt build where a failed uniqueness test shows its duplicates, and a downstream model skips.","dependencies":[],"registryDependencies":["card","table","trace"],"files":[{"path":"c-trace-13.tsx","type":"registry:block","content":"import { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport {\n  Trace,\n  TraceCollapsible,\n  TraceCollapsibleContent,\n  TraceCollapsibleTrigger,\n  TraceDescription,\n  TraceIcon,\n  TraceLine,\n  TraceTitle,\n} from \"@/components/ui/trace\"\nimport { IconPlaceholder } from \"@/app/(create)/components/icon-placeholder\"\n\nconst MODELS = [\n  { name: \"stg_orders\", rows: \"1.2M rows\" },\n  { name: \"stg_customers\", rows: \"84K rows\" },\n  { name: \"int_order_items\", rows: \"3.4M rows\" },\n  { name: \"fct_revenue\", rows: \"1.1M rows\" },\n]\n\nconst DUPLICATES = [\n  { orderId: \"ord_8821340\", copies: 2 },\n  { orderId: \"ord_8823004\", copies: 3 },\n]\n\n// The skipped model stays listed as pending, so the run shows which report is\n// stale.\nexport function Pattern() {\n  return (\n    <div className=\"w-full max-w-md text-sm\">\n      <Trace>\n        <TraceCollapsible>\n          <TraceCollapsibleTrigger>\n            <TraceLine>\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"DatabaseIcon\"\n                  tabler=\"IconDatabase\"\n                  hugeicons=\"Database02Icon\"\n                  phosphor=\"DatabaseIcon\"\n                  remixicon=\"RiDatabase2Line\"\n                />\n              </TraceIcon>\n              <TraceTitle>Built {MODELS.length} models</TraceTitle>\n              <TraceDescription>1m 24s</TraceDescription>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            <Trace>\n              {MODELS.map((model) => (\n                <TraceLine key={model.name}>\n                  <TraceTitle>{model.name}</TraceTitle>\n                  <TraceDescription>{model.rows}</TraceDescription>\n                </TraceLine>\n              ))}\n            </Trace>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceCollapsible defaultOpen>\n          <TraceCollapsibleTrigger>\n            <TraceLine status=\"error\">\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"FlaskConicalIcon\"\n                  tabler=\"IconFlask\"\n                  hugeicons=\"TestTube01Icon\"\n                  phosphor=\"FlaskIcon\"\n                  remixicon=\"RiFlaskLine\"\n                />\n              </TraceIcon>\n              <TraceTitle>Unique test failed on fct_revenue</TraceTitle>\n              <TraceDescription>\n                {DUPLICATES.length} duplicates\n              </TraceDescription>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            {/* A borderless Card is the outer frame; the table sits flush in it. */}\n            <Card className=\"p-0\">\n              <CardContent className=\"p-0\">\n                <Table>\n                  <TableHeader>\n                    <TableRow>\n                      <TableHead className=\"h-8\">order_id</TableHead>\n                      <TableHead className=\"h-8 text-right\">Copies</TableHead>\n                    </TableRow>\n                  </TableHeader>\n                  <TableBody>\n                    {DUPLICATES.map((row) => (\n                      <TableRow key={row.orderId}>\n                        <TableCell className=\"py-1.5\">\n                          <code className=\"text-xs\">{row.orderId}</code>\n                        </TableCell>\n                        <TableCell className=\"py-1.5 text-right\">\n                          {row.copies}\n                        </TableCell>\n                      </TableRow>\n                    ))}\n                  </TableBody>\n                </Table>\n              </CardContent>\n            </Card>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceLine status=\"pending\">\n          <TraceIcon>\n            <IconPlaceholder\n              lucide=\"CircleDashedIcon\"\n              tabler=\"IconCircleDashed\"\n              hugeicons=\"CircleDashedIcon\"\n              phosphor=\"CircleDashedIcon\"\n              remixicon=\"RiCheckboxBlankCircleLine\"\n            />\n          </TraceIcon>\n          <TraceTitle>Skipped dim_customer_ltv</TraceTitle>\n          <TraceDescription>upstream failed</TraceDescription>\n        </TraceLine>\n      </Trace>\n    </div>\n  )\n}","target":"components/examples/c-trace-13.tsx"}],"meta":{"order":13,"gridSize":2,"label":"Data Pipeline"}}