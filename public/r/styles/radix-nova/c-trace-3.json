{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"c-trace-3","type":"registry:block","title":"Chat turn with sources","description":"An assistant reply whose SQL queries fold into one summary above the answer, with the dashboards it cited below.","dependencies":[],"registryDependencies":["bubble","@reui/code-block","message","trace"],"files":[{"path":"c-trace-3.tsx","type":"registry:block","content":"import { CodeBlock } from \"@/components/reui/code-block/code-block\"\n\nimport { Bubble, BubbleContent } from \"@/components/ui/bubble\"\nimport { Message, MessageContent } from \"@/components/ui/message\"\nimport {\n  Trace,\n  TraceCollapsible,\n  TraceCollapsibleContent,\n  TraceCollapsibleTrigger,\n  TraceDescription,\n  TraceIcon,\n  TraceLine,\n  TraceTitle,\n} from \"@/components/ui/trace\"\nimport { IconPlaceholder } from \"@/app/(create)/components/icon-placeholder\"\n\nconst QUERIES = [\n  {\n    id: \"by-day\",\n    title: \"Queried trial signups by day\",\n    description: \"28 rows\",\n    sql: `select date_trunc('day', created_at) as day, count(*)\nfrom trials\nwhere created_at >= current_date - 27\ngroup by 1 order by 1`,\n  },\n  {\n    id: \"by-domain\",\n    title: \"Queried bounces by email domain\",\n    description: \"12 rows\",\n    sql: `select split_part(email, '@', 2) as domain, count(*)\nfrom verification_attempts\nwhere status = 'bounced' and created_at::date = '2026-10-06'\ngroup by 1 order by 2 desc limit 12`,\n  },\n]\n\nconst DASHBOARDS = [\n  { title: \"Activation funnel, weekly\", href: \"#\" },\n  { title: \"Email delivery health\", href: \"#\" },\n]\n\n// The work folds into one row above the answer and the sources sit below it.\n// keeps an opened query open when the summary folds.\nexport function Pattern() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-6 text-sm\">\n      <Message align=\"end\">\n        <MessageContent>\n          <Bubble align=\"end\" variant=\"muted\">\n            <BubbleContent>\n              Why did trial signups drop last Tuesday?\n            </BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n      <Message>\n        <MessageContent>\n          <div className=\"flex flex-col gap-4\">\n            <Trace>\n              <TraceCollapsible defaultOpen>\n                <TraceCollapsibleTrigger>\n                  <TraceLine>\n                    <TraceTitle>Worked for 38s</TraceTitle>\n                    <TraceDescription>\n                      {QUERIES.length} queries\n                    </TraceDescription>\n                  </TraceLine>\n                </TraceCollapsibleTrigger>\n                <TraceCollapsibleContent>\n                  <Trace>\n                    {QUERIES.map((query) => (\n                      <TraceCollapsible key={query.id}>\n                        <TraceCollapsibleTrigger>\n                          <TraceLine>\n                            <TraceIcon>\n                              <IconPlaceholder\n                                lucide=\"DatabaseIcon\"\n                                tabler=\"IconDatabase\"\n                                hugeicons=\"Database02Icon\"\n                                phosphor=\"DatabaseIcon\"\n                                remixicon=\"RiDatabase2Line\"\n                              />\n                            </TraceIcon>\n                            <TraceTitle>{query.title}</TraceTitle>\n                            <TraceDescription>\n                              {query.description}\n                            </TraceDescription>\n                          </TraceLine>\n                        </TraceCollapsibleTrigger>\n                        <TraceCollapsibleContent>\n                          <CodeBlock\n                            code={query.sql}\n                            language=\"sql\"\n                            label={query.title}\n                            wrap\n                          />\n                        </TraceCollapsibleContent>\n                      </TraceCollapsible>\n                    ))}\n                  </Trace>\n                </TraceCollapsibleContent>\n              </TraceCollapsible>\n            </Trace>\n            <p className=\"leading-relaxed text-pretty\">\n              Signups fell 41% because verification emails to Gmail bounced for\n              4 hours after the DKIM record broke.\n            </p>\n            <Trace>\n              <TraceCollapsible>\n                <TraceCollapsibleTrigger>\n                  <TraceLine>\n                    <TraceIcon>\n                      <IconPlaceholder\n                        lucide=\"ChartLineIcon\"\n                        tabler=\"IconChartLine\"\n                        hugeicons=\"ChartLineData01Icon\"\n                        phosphor=\"ChartLineIcon\"\n                        remixicon=\"RiLineChartLine\"\n                      />\n                    </TraceIcon>\n                    <TraceTitle>Used {DASHBOARDS.length} dashboards</TraceTitle>\n                  </TraceLine>\n                </TraceCollapsibleTrigger>\n                <TraceCollapsibleContent>\n                  <Trace>\n                    {DASHBOARDS.map((dashboard) => (\n                      <a key={dashboard.title} href={dashboard.href}>\n                        <TraceLine>\n                          <TraceTitle>{dashboard.title}</TraceTitle>\n                          <TraceIcon>\n                            <IconPlaceholder\n                              lucide=\"ChevronRightIcon\"\n                              tabler=\"IconChevronRight\"\n                              hugeicons=\"ArrowRight01Icon\"\n                              phosphor=\"CaretRightIcon\"\n                              remixicon=\"RiArrowRightSLine\"\n                            />\n                          </TraceIcon>\n                        </TraceLine>\n                      </a>\n                    ))}\n                  </Trace>\n                </TraceCollapsibleContent>\n              </TraceCollapsible>\n            </Trace>\n          </div>\n        </MessageContent>\n      </Message>\n    </div>\n  )\n}","target":"components/examples/c-trace-3.tsx"}],"meta":{"order":3,"gridSize":2,"label":"Chat Turn"}}