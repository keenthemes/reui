{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"c-trace-21","type":"registry:block","title":"Domain DNS setup","description":"Sending domain setup with records to copy, a lookup that finds 2 of 3, then the go live step once DNS passes.","dependencies":[],"registryDependencies":["button","card","table","trace"],"files":[{"path":"c-trace-21.tsx","type":"registry:block","content":"\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport {\n  Trace,\n  TraceCollapsible,\n  TraceCollapsibleContent,\n  TraceCollapsibleTrigger,\n  TraceIcon,\n  TraceLine,\n  TraceTitle,\n} from \"@/components/ui/trace\"\nimport { IconPlaceholder } from \"@/app/(create)/components/icon-placeholder\"\n\nconst DOMAIN = \"mail.northwind.dev\"\n\nconst RECORDS = [\n  {\n    id: \"spf\",\n    label: \"SPF\",\n    type: \"TXT\",\n    name: \"mail\",\n    value: \"v=spf1 include:_spf.mailer.dev ~all\",\n  },\n  {\n    id: \"dkim\",\n    label: \"DKIM\",\n    type: \"CNAME\",\n    name: \"k1._domainkey.mail\",\n    value: \"k1.dkim.mailer.dev\",\n  },\n  {\n    id: \"dmarc\",\n    label: \"DMARC\",\n    type: \"TXT\",\n    name: \"_dmarc.mail\",\n    value: \"v=DMARC1; p=none; rua=mailto:dmarc@northwind.dev\",\n  },\n]\n\ntype Phase = \"checking\" | \"partial\" | \"rechecking\" | \"ready\"\n\n// The records stay open beside the check that waits on them.\nexport function Pattern() {\n  const [phase, setPhase] = React.useState<Phase>(\"checking\")\n  const [copied, setCopied] = React.useState<string | null>(null)\n  const statusRef = React.useRef<HTMLParagraphElement>(null)\n\n  React.useEffect(() => {\n    const next: Partial<Record<Phase, Phase>> = {\n      checking: \"partial\",\n      rechecking: \"ready\",\n    }\n    const target = next[phase]\n    if (!target) return\n    const timer = window.setTimeout(() => setPhase(target), 1600)\n    return () => window.clearTimeout(timer)\n  }, [phase])\n\n  React.useEffect(() => {\n    if (!copied) return\n    const timer = window.setTimeout(() => setCopied(null), 1500)\n    return () => window.clearTimeout(timer)\n  }, [copied])\n\n  async function copy(id: string, value: string) {\n    try {\n      await navigator.clipboard.writeText(value)\n      setCopied(id)\n    } catch {\n      // Clipboard access is refused outside a secure context. The full value\n      // is still in the cell's title.\n    }\n  }\n\n  const checking = phase === \"checking\" || phase === \"rechecking\"\n  const verified = phase === \"ready\"\n  const found =\n    phase === \"partial\"\n      ? [\"spf\", \"dkim\"]\n      : verified\n        ? RECORDS.map((r) => r.id)\n        : []\n\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-4 text-sm\">\n      <Trace>\n        <TraceCollapsible defaultOpen>\n          <TraceCollapsibleTrigger>\n            <TraceLine>\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"ListIcon\"\n                  tabler=\"IconList\"\n                  hugeicons=\"LeftToRightListBulletIcon\"\n                  phosphor=\"ListIcon\"\n                  remixicon=\"RiListUnordered\"\n                />\n              </TraceIcon>\n              <TraceTitle>\n                Add {RECORDS.length} records at your DNS provider\n              </TraceTitle>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            {/* A borderless Card is the outer frame; the table sits flush in it. */}\n            <Card className=\"p-0\">\n              <CardContent className=\"p-0\">\n                <Table className=\"table-fixed\">\n                  <TableHeader>\n                    <TableRow>\n                      <TableHead className=\"h-8 w-16\">Type</TableHead>\n                      <TableHead className=\"h-8 w-28\">Name</TableHead>\n                      <TableHead className=\"h-8\">Value</TableHead>\n                      <TableHead className=\"h-8 w-9\">\n                        <span className=\"sr-only\">Copy</span>\n                      </TableHead>\n                    </TableRow>\n                  </TableHeader>\n                  <TableBody>\n                    {RECORDS.map((record) => (\n                      <TableRow key={record.id}>\n                        <TableCell className=\"py-1.5\">{record.type}</TableCell>\n                        <TableCell className=\"py-1.5\">\n                          <code className=\"block truncate text-xs\">\n                            {record.name}\n                          </code>\n                        </TableCell>\n                        <TableCell className=\"py-1.5\" title={record.value}>\n                          <code className=\"block truncate text-xs\">\n                            {record.value}\n                          </code>\n                        </TableCell>\n                        <TableCell className=\"py-1.5\">\n                          <Button\n                            size=\"icon-xs\"\n                            variant=\"ghost\"\n                            aria-label={`Copy the ${record.label} value`}\n                            onClick={() => copy(record.id, record.value)}\n                          >\n                            {copied === record.id ? (\n                              <IconPlaceholder\n                                lucide=\"CheckIcon\"\n                                tabler=\"IconCheck\"\n                                hugeicons=\"Tick02Icon\"\n                                phosphor=\"CheckIcon\"\n                                remixicon=\"RiCheckLine\"\n                              />\n                            ) : (\n                              <IconPlaceholder\n                                lucide=\"CopyIcon\"\n                                tabler=\"IconCopy\"\n                                hugeicons=\"Copy01Icon\"\n                                phosphor=\"CopyIcon\"\n                                remixicon=\"RiFileCopyLine\"\n                              />\n                            )}\n                          </Button>\n                        </TableCell>\n                      </TableRow>\n                    ))}\n                  </TableBody>\n                </Table>\n              </CardContent>\n            </Card>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceCollapsible defaultOpen>\n          <TraceCollapsibleTrigger>\n            <TraceLine\n              status={\n                checking ? \"running\" : phase === \"partial\" ? \"error\" : undefined\n              }\n            >\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"SearchIcon\"\n                  tabler=\"IconSearch\"\n                  hugeicons=\"Search01Icon\"\n                  phosphor=\"MagnifyingGlassIcon\"\n                  remixicon=\"RiSearchLine\"\n                />\n              </TraceIcon>\n              <TraceTitle>\n                {checking\n                  ? \"Checking DNS for the records\"\n                  : verified\n                    ? \"Verified all 3 records\"\n                    : \"Found 2 of 3 records, DMARC is missing\"}\n              </TraceTitle>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            <Trace>\n              {RECORDS.map((record) => {\n                const ok = found.includes(record.id)\n                return (\n                  <TraceLine\n                    key={record.id}\n                    status={checking ? \"pending\" : ok ? undefined : \"error\"}\n                  >\n                    <TraceTitle>\n                      {checking\n                        ? `Look up ${record.label}`\n                        : ok\n                          ? `${record.label} resolves`\n                          : `${record.label} not found on ${record.name}`}\n                    </TraceTitle>\n                  </TraceLine>\n                )\n              })}\n            </Trace>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceLine status={phase === \"ready\" ? undefined : \"pending\"}>\n          <TraceIcon>\n            <IconPlaceholder\n              lucide=\"SendIcon\"\n              tabler=\"IconSend\"\n              hugeicons=\"SentIcon\"\n              phosphor=\"PaperPlaneTiltIcon\"\n              remixicon=\"RiSendInsLine\"\n            />\n          </TraceIcon>\n          <TraceTitle>\n            {phase === \"ready\"\n              ? `Ready to send from ${DOMAIN}`\n              : `Start sending from ${DOMAIN}`}\n          </TraceTitle>\n        </TraceLine>\n      </Trace>\n      <div className=\"flex items-center gap-3\">\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          disabled={phase !== \"partial\"}\n          onClick={() => {\n            setPhase(\"rechecking\")\n            // The button disables itself, so focus moves to the status line.\n            statusRef.current?.focus()\n          }}\n        >\n          Check DNS again\n        </Button>\n        <p\n          ref={statusRef}\n          role=\"status\"\n          tabIndex={-1}\n          className=\"text-muted-foreground min-w-0 text-xs outline-none\"\n        >\n          {checking\n            ? \"Checking\"\n            : phase === \"partial\"\n              ? \"DNS changes can take up to an hour\"\n              : \"Domain verified\"}\n        </p>\n      </div>\n      <p role=\"status\" className=\"sr-only\">\n        {copied\n          ? `Copied the ${RECORDS.find((r) => r.id === copied)?.label} value`\n          : \"\"}\n      </p>\n    </div>\n  )\n}","target":"components/examples/c-trace-21.tsx"}],"meta":{"order":21,"gridSize":2,"label":"Domain Setup"}}