{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"c-trace-8","type":"registry:block","title":"CLI install summary","description":"What a shadcn add run resolved, installed and wrote, including a file it kept because it already existed.","dependencies":[],"registryDependencies":["@reui/code-block","trace"],"files":[{"path":"c-trace-8.tsx","type":"registry:block","content":"import { CodeBlock } from \"@/components/reui/code-block/code-block\"\n\nimport {\n  Trace,\n  TraceCollapsible,\n  TraceCollapsibleContent,\n  TraceCollapsibleTrigger,\n  TraceDescription,\n  TraceIcon,\n  TraceLine,\n  TraceTitle,\n} from \"@/components/ui/trace\"\nimport { IconPlaceholder } from \"@/app/(create)/components/icon-placeholder\"\n\nconst ITEMS = [\n  { name: \"@reui/c-data-grid-1\", kind: \"example\" },\n  { name: \"@reui/data-grid\", kind: \"component\" },\n  { name: \"button\", kind: \"ui\" },\n]\n\nconst FILES = [\n  { path: \"components/reui/data-grid/data-grid.tsx\", created: true },\n  { path: \"components/ui/button.tsx\", created: false },\n  { path: \"components/examples/c-data-grid-1.tsx\", created: true },\n]\n\nconst css = `@theme inline {\n  --color-success: var(--success);\n  --color-info: var(--info);\n  --color-warning: var(--warning);\n}`\n\n// A file that already existed is kept, because shadcn add never overwrites a\n// file without asking.\nexport function Pattern() {\n  const created = FILES.filter((file) => file.created)\n  const skipped = FILES.filter((file) => !file.created)\n\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-4 text-sm\">\n      <Trace>\n        <TraceLine>\n          <TraceIcon>\n            <IconPlaceholder\n              lucide=\"TerminalIcon\"\n              tabler=\"IconTerminal\"\n              hugeicons=\"ComputerTerminal01Icon\"\n              phosphor=\"TerminalIcon\"\n              remixicon=\"RiTerminalLine\"\n            />\n          </TraceIcon>\n          <TraceTitle>Ran shadcn add @reui/c-data-grid-1</TraceTitle>\n          <TraceDescription>9.4s</TraceDescription>\n        </TraceLine>\n        <TraceCollapsible>\n          <TraceCollapsibleTrigger>\n            <TraceLine>\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"BoxesIcon\"\n                  tabler=\"IconBoxMultiple\"\n                  hugeicons=\"BoxesIcon\"\n                  phosphor=\"CubeIcon\"\n                  remixicon=\"RiStackLine\"\n                />\n              </TraceIcon>\n              <TraceTitle>Resolved {ITEMS.length} registry items</TraceTitle>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            <Trace>\n              {ITEMS.map((item) => (\n                <TraceLine key={item.name}>\n                  <TraceTitle>\n                    <code>{item.name}</code>\n                  </TraceTitle>\n                  <TraceDescription>{item.kind}</TraceDescription>\n                </TraceLine>\n              ))}\n            </Trace>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceLine>\n          <TraceIcon>\n            <IconPlaceholder\n              lucide=\"PackageIcon\"\n              tabler=\"IconPackage\"\n              hugeicons=\"PackageIcon\"\n              phosphor=\"PackageIcon\"\n              remixicon=\"RiBox3Line\"\n            />\n          </TraceIcon>\n          <TraceTitle>Installed @tanstack/react-table</TraceTitle>\n          <TraceDescription>6.1s</TraceDescription>\n        </TraceLine>\n        <TraceCollapsible defaultOpen>\n          <TraceCollapsibleTrigger>\n            <TraceLine>\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"FileCodeIcon\"\n                  tabler=\"IconFileCode\"\n                  hugeicons=\"FileScriptIcon\"\n                  phosphor=\"FileCodeIcon\"\n                  remixicon=\"RiFileCodeLine\"\n                />\n              </TraceIcon>\n              <TraceTitle>\n                Wrote {created.length} files, kept {skipped.length}\n              </TraceTitle>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            <Trace>\n              {FILES.map((file) =>\n                file.created ? (\n                  <a key={file.path} href=\"#\">\n                    <TraceLine>\n                      <TraceTitle>Created {file.path}</TraceTitle>\n                    </TraceLine>\n                  </a>\n                ) : (\n                  <TraceLine key={file.path}>\n                    <TraceTitle>Kept {file.path}, it already exists</TraceTitle>\n                  </TraceLine>\n                )\n              )}\n            </Trace>\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n        <TraceCollapsible>\n          <TraceCollapsibleTrigger>\n            <TraceLine>\n              <TraceIcon>\n                <IconPlaceholder\n                  lucide=\"PaletteIcon\"\n                  tabler=\"IconPalette\"\n                  hugeicons=\"PaintBoardIcon\"\n                  phosphor=\"PaletteIcon\"\n                  remixicon=\"RiPaletteLine\"\n                />\n              </TraceIcon>\n              <TraceTitle>Updated app/globals.css</TraceTitle>\n              <TraceDescription>+3</TraceDescription>\n            </TraceLine>\n          </TraceCollapsibleTrigger>\n          <TraceCollapsibleContent>\n            <CodeBlock\n              code={css}\n              language=\"css\"\n              diff={{ added: [2, 3, 4] }}\n              label=\"Changes to app/globals.css\"\n            />\n          </TraceCollapsibleContent>\n        </TraceCollapsible>\n      </Trace>\n    </div>\n  )\n}","target":"components/examples/c-trace-8.tsx"}],"meta":{"order":8,"gridSize":2,"label":"Install Summary"}}