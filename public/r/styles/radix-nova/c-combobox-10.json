{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"c-combobox-10","type":"registry:block","title":"A popup combobox with a clear button","description":"A popup combobox with a clear button","dependencies":[],"registryDependencies":["button","button-group","combobox","field"],"files":[{"path":"c-combobox-10.tsx","type":"registry:block","content":"import { Button } from \"@/components/ui/button\"\nimport { ButtonGroup } from \"@/components/ui/button-group\"\nimport {\n  Combobox,\n  ComboboxClear,\n  ComboboxContent,\n  ComboboxEmpty,\n  ComboboxInput,\n  ComboboxItem,\n  ComboboxList,\n  ComboboxTrigger,\n  ComboboxValue,\n} from \"@/components/ui/combobox\"\nimport { Field } from \"@/components/ui/field\"\n\nconst countries = [\n  { code: \"af\", label: \"Afghanistan\" },\n  { code: \"al\", label: \"Albania\" },\n  { code: \"dz\", label: \"Algeria\" },\n  { code: \"as\", label: \"American Samoa\" },\n  { code: \"ad\", label: \"Andorra\" },\n  { code: \"ao\", label: \"Angola\" },\n]\n\nexport function Pattern() {\n  return (\n    <Field className=\"max-w-xs\">\n      <Combobox\n        items={countries}\n        defaultValue={countries[0]}\n        itemToStringValue={(item: (typeof countries)[number]) => item.label}\n      >\n        <ButtonGroup>\n          <ComboboxTrigger\n            render={\n              <Button\n                variant=\"outline\"\n                className=\"min-w-40 flex-1 justify-between font-normal\"\n              />\n            }\n          >\n            <ComboboxValue placeholder=\"Select a country\">\n              {(item: (typeof countries)[number] | null) =>\n                item ? (\n                  <span className=\"flex items-center gap-2\">\n                    <img\n                      src={`https://flagcdn.com/${item.code.toLowerCase()}.svg`}\n                      alt=\"\"\n                      width={16}\n                      height={16}\n                      className=\"rounded-xs\"\n                    />\n                    <span>{item.label}</span>\n                  </span>\n                ) : (\n                  \"Select a country\"\n                )\n              }\n            </ComboboxValue>\n          </ComboboxTrigger>\n          <ComboboxClear render={<Button variant=\"outline\" size=\"icon\" />} />\n        </ButtonGroup>\n        <ComboboxContent className=\"max-w-(--anchor-width) min-w-(--anchor-width)\">\n          <ComboboxInput showTrigger={false} placeholder=\"Search\" />\n          <ComboboxEmpty>No items found.</ComboboxEmpty>\n          <ComboboxList>\n            {(item) => (\n              <ComboboxItem key={item.code} value={item}>\n                <img\n                  src={`https://flagcdn.com/${item.code.toLowerCase()}.svg`}\n                  alt=\"\"\n                  width={16}\n                  height={12}\n                  className=\"rounded-xs\"\n                />\n                {item.label}\n              </ComboboxItem>\n            )}\n          </ComboboxList>\n        </ComboboxContent>\n      </Combobox>\n    </Field>\n  )\n}","target":"components/examples/c-combobox-10.tsx"}],"meta":{"order":10}}